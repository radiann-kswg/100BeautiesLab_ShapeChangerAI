# .env.example — 100BeautiesLab_ShapeChangerAI
#
# 使い方: このファイルを .env にコピーして値を埋める。.env はコミットしない（.gitignore 済み）。
# GeneratorsAI の .env をそのまま置いても動く（下記以外のキーは読まない）。

# --- Gemini (Nano Banana) — --provider gemini（既定） -------------------------
GEMINI_API_KEY=
# 使用モデル。未設定なら GEMINI_REFERENCE_MODEL、それも無ければ gemini-nano-banana-2.1
GEMINI_IMAGE_MODEL=
# 複数枚生成時の待ち秒数（既定 6）
GEMINI_IMAGE_SLEEP=

# --- OpenAI (GPT Image) — --provider openai ----------------------------------
OPENAI_API_KEY=
# 使用モデル（既定 gpt-image-2.6-sunburst）。
# GeneratorsAI の DALLE_MODEL / OPENAI_CORRECTION_MODEL はここでは読まない。
OPENAI_IMAGE_MODEL=
# low / medium / high / auto（未設定なら API の既定。standard は medium、hd は high に読み替える）
OPENAI_IMAGE_QUALITY=

# --- 検査（Stage 2 の観察と Stage 4 の検査。OPENAI_API_KEY を使う） ----------
# Vision に使うモデル（既定 gpt-4o。GeneratorsAI と同じ変数）
GPT_MODEL=

# --- Canva 仕上げ（Stage 5。未設定なら省く） ---------------------------------
# このリポジトリ用の Canva 連携（Developer Portal で作る）。GeneratorsAI の CANVA_* は読まない
SHAPECHANGE_CANVA_CLIENT_ID=
SHAPECHANGE_CANVA_CLIENT_SECRET=
# 次の 2 件は python -m src.tools.refresh_canva_token が書き込む（手順は src/README.md）
SHAPECHANGE_CANVA_ACCESS_TOKEN=
SHAPECHANGE_CANVA_REFRESH_TOKEN=
# 書き出し形式 png / jpg（既定 png）
CANVA_EXPORT_FORMAT=

# --- MCP サーバー（python -m src.mcp_server） --------------------------------
# stdio（既定・ローカル）/ streamable-http（リモート）
MCP_TRANSPORT=
HOST=
PORT=
# HTTP で公開するときの URL。設定すると OAuth（自動承認）が有効になる
MCP_ISSUER_URL=
# 完成画像の届け先: local（既定）/ drive / gcs
OUTPUT_SINK=
DRIVE_FOLDER_ID=
DRIVE_CLIENT_ID=
DRIVE_CLIENT_SECRET=
DRIVE_REFRESH_TOKEN=
# 中間画像の置き場（任意）
GCS_BUCKET=
GCS_PREFIX=

# --- 入力元の上書き（通常は不要） --------------------------------------------
# manifest.jsonl の場所（既定 _creations-ai/ai-dataset/manifest.jsonl）
MANIFEST_PATH=
# VRCShader_ShapeChange の場所（既定はサブモジュール VRCShader_ShapeChange/）
# VM では python -m src.shape.vm_bundle が書き出した 2 ファイルだけのフォルダーを指す
SHAPECHANGE_REPO_PATH=
